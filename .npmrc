# A dependency that was compromised must not run code on the machine that installs it: no lifecycle script of any
# dependency runs. Only esbuild and fsevents declare one (package-lock.json); esbuild works through its platform
# package without it. A step that needs a script runs it by name, as the mermaid job of .github/workflows/ci.yml does
# for the browser download. scripts/install.sh and the CI jobs also pass --ignore-scripts, so a .npmrc that is missing
# or edited does not turn it back on (test/supply-chain.test.ts).
ignore-scripts=true

# engines.node (>=22.13) is binding: npm refuses to install on a Node older than the one the kit needs, instead of warning.
engine-strict=true
