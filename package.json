{
  "name": "cursor-workflows-starter",
  "version": "0.2.0",
  "private": true,
  "description": "Starter kit: workflows determinísticos sobre o Cursor SDK, invocáveis pelo chat do Cursor IDE (MCP) e pelo terminal (CLI).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "wf": "tsx packages/runtime/src/cli.ts",
    "mcp": "tsx packages/runtime/src/mcp-server.ts",
    "typecheck": "tsc --noEmit",
    "models": "tsx packages/runtime/src/cli.ts models",
    "test": "npm run test --workspaces --if-present && tsx --test test/*.test.ts",
    "dash": "tsx packages/runtime/src/observability/dashboard.ts",
    "stats": "tsx packages/runtime/src/cli.ts stats"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@types/node": "^22.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
