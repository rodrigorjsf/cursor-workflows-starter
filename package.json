{
  "name": "cursor-workflows-starter",
  "version": "0.3.0",
  "private": true,
  "description": "Starter kit: workflows determinísticos sobre o Cursor SDK, invocáveis pelo chat do Cursor IDE (MCP) e pelo terminal (CLI).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "wf": "tsx packages/runtime/src/cli.ts",
    "mcp": "tsx packages/runtime/src/mcp-server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/dashboard/src/ui",
    "models": "tsx packages/runtime/src/cli.ts models",
    "test": "npm run test --workspaces --if-present && tsx --test test/*.test.ts",
    "dash": "tsx packages/dashboard/src/main.ts",
    "stats": "tsx packages/runtime/src/cli.ts stats",
    "docs:check": "tsx scripts/check-docs.ts",
    "docs:mermaid": "tsx scripts/check-mermaid.ts",
    "docs:events": "tsx scripts/events-reference.ts",
    "docs:config": "tsx scripts/config-reference.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/semver": "^7.8.0",
    "typescript": "^5.9.0"
  }
}
