{
  "mcpServers": {
    "workflows": {
      "command": "node",
      "args": ["--import", "${workspaceFolder}/node_modules/tsx/dist/loader.mjs", "${workspaceFolder}/packages/runtime/src/mcp-server.ts"],
      "env": {
        "WF_CWD": "${workspaceFolder}",
        "WF_MAX_CENTS": "500",
        "WF_MAX_TOKENS": "2000000"
      }
    }
  }
}
