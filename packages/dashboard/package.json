{
  "name": "@cursor-workflows/dashboard",
  "version": "0.4.0",
  "private": true,
  "description": "The kit's local dashboard: a local web server over the runs and the metrics of every repo; it reads, and its one action is cancelling a run.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p app && tsc --noEmit -p run-view",
    "test": "tsx --tsconfig ../runtime/tsconfig.test.json --test test/*.test.ts"
  },
  "dependencies": {
    "@cursor-workflows/runtime": "*",
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
